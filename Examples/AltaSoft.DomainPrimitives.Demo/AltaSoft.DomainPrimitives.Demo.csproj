<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
	<TargetFrameworks>net10.0;net11.0</TargetFrameworks>
	<Nullable>enable</Nullable>
	<ImplicitUsings>enable</ImplicitUsings>
	<InvariantGlobalization>true</InvariantGlobalization>
	<IsPackable>false</IsPackable>
	<NoWarn>1591</NoWarn>
  </PropertyGroup>

	<PropertyGroup>
		<InterceptorsNamespaces>
			$(InterceptorsNamespaces);Microsoft.AspNetCore.OpenApi.Generated
		</InterceptorsNamespaces>
	</PropertyGroup>

  <ItemGroup>
	<PackageReference Include="Scalar.AspNetCore" Version="2.20.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
	<PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.*" />
	<PackageReference Include="Swashbuckle.AspNetCore" Version="10.3.*" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net11.0'">
	<PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="11.0.*" />
	<PackageReference Include="Swashbuckle.AspNetCore" Version="11.0.*" />
  </ItemGroup>

  <ItemGroup>
	<ProjectReference Include="..\..\src\AltaSoft.DomainPrimitives.OpenApiExtensions\AltaSoft.DomainPrimitives.OpenApiExtensions.csproj" />
	<ProjectReference Include="..\..\src\AltaSoft.DomainPrimitives.SwaggerExtensions\AltaSoft.DomainPrimitives.SwaggerExtensions.csproj" />
	<ProjectReference Include="..\DomainPrimitivesDemo\DomainPrimitivesDemo.csproj" />
  </ItemGroup>

</Project>
